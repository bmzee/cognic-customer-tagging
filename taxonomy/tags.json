      "reason": "average monthly earned income fell to {income_change} of its earlier level: {income_change.numerator} a month in the last 3 months against {income_change.denominator} in the 6 months before"
    },
    {
      "id": "large-recent-inflow",
      "name": "Large recent inflow",
      "group": "income",
      "description": "Received a single large credit recently, several times the usual monthly money in.",
      "fields": [
        "transactions.amount",
        "transactions.category",
        "transactions.currency",
        "transactions.direction",
        "transactions.posted_date"
      ],
      "rule": {
        "all": [
          {
            "id": "largest",
            "description": "largest single credit",
            "metric": "max",
            "filter": {
              "direction": "credit",
              "category": {
                "not_in": [
                  "refund",
                  "loan_disbursement"
                ]
              }
            },
            "window": {
              "months": 3
            },
            "op": ">=",
            "value": 5000
          },
          {
            "id": "inflow_ratio",
            "description": "largest single credit against the usual monthly money in",
            "metric": "ratio",
            "numerator": {
              "metric": "max",
              "filter": {
                "direction": "credit",
                "category": {
                  "not_in": [
                    "refund",
                    "loan_disbursement"
                  ]
                }
              },
              "window": {
                "months": 3
              }
            },
            "denominator": {
              "metric": "sum_per_month",
              "filter": {
                "direction": "credit",
                "category": {
                  "not_in": [
                    "refund",
                    "loan_disbursement"
                  ]
                }
              },
              "window": {
                "months": 6,
                "offset_months": 3
              }
            },
            "min_denominator": 200,
            "op": ">=",
            "value": 3
          }
        ]
      },
      "reason": "a single credit of {largest} in the last 3 months, {inflow_ratio} the usual monthly money in of {inflow_ratio.denominator} in the 6 months before"
    },
