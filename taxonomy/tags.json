            },
            "of": {
              "direction": "debit",
              "channel": {
                "not_in": [
                  "system"
                ]
              }
            },
            "by": "amount",
            "window": {
              "days": 90
            },
            "op": ">=",
            "value": 0.4
          },
          {
            "id": "cash_count",
            "description": "cash withdrawals",
            "metric": "count",
            "filter": {
              "direction": "debit",
              "category": "cash_withdrawal"
            },
            "window": {
              "days": 90
            },
            "op": ">=",
            "value": 4
          }
        ]
      },
      "reason": "cash withdrawals were {cash_share} of spending in the last 90 days, {cash_count} withdrawals"
    },
    {
      "id": "foreign-currency-spender",
      "name": "Foreign-currency spender",
      "group": "spending",
      "description": "A large part of card spending is in foreign currencies.",
      "fields": [
        "customers.home_currency",
        "transactions.amount",
        "transactions.channel",
        "transactions.currency",
        "transactions.direction",
        "transactions.posted_date"
      ],
      "rule": {
        "all": [
          {
            "id": "fx_share",
            "description": "share of card spending in a foreign currency",
            "metric": "share",
            "filter": {
              "is_foreign_currency": true
            },
            "of": {
              "direction": "debit",
              "channel": [
                "card_pos",
                "card_online"
              ]
            },
            "by": "amount",
            "window": {
              "days": 90
            },
            "op": ">=",
            "value": 0.25
          },
          {
            "id": "fx_count",
            "description": "card payments in a foreign currency",
            "metric": "count",
            "filter": {
              "direction": "debit",
              "channel": [
                "card_pos",
                "card_online"
              ],
              "is_foreign_currency": true
            },
            "window": {
              "days": 90
            },
            "op": ">=",
            "value": 3
          }
        ]
      },
      "reason": "{fx_share} of card spending in the last 90 days was in foreign currencies, {fx_count} payments"
    },
    {
      "id": "digital-first",
      "name": "Digital-first",
      "group": "channels",
      "description": "Does almost all self-service banking in the app, online banking or with online card payments.",
      "fields": [
        "transactions.channel",
        "transactions.posted_date"
      ],
      "rule": {
        "all": [
          {
            "id": "digital_share",
            "description": "share of self-service transactions made digitally",
            "metric": "share",
            "filter": {
              "channel": [
                "mobile_app",
                "internet_banking",
                "card_online"
              ]
            },
            "of": {
              "channel": {
                "not_in": [
                  "incoming",
                  "system"
                ]
              }
            },
            "by": "count",
            "window": {
              "days": 90
            },
            "op": ">=",
            "value": 0.8
          },
          {
            "id": "self_count",
            "description": "self-service transactions",
            "metric": "count",
            "filter": {
              "channel": {
                "not_in": [
                  "incoming",
                  "system"
                ]
              }
            },
            "window": {
              "days": 90
            },
            "op": ">=",
            "value": 10
          }
        ]
      },
      "reason": "{digital_share} of {self_count} self-service transactions in the last 90 days were in the app, online banking or online card payments"
    },
    {
      "id": "branch-reliant",
      "name": "Branch-reliant",
      "group": "channels",
      "description": "Does much of their self-service banking in a branch.",
      "fields": [
        "transactions.channel",
        "transactions.posted_date"
      ],
      "rule": {
        "all": [
          {
            "id": "branch_share",
            "description": "share of self-service transactions made in a branch",
            "metric": "share",
            "filter": {
              "channel": "branch"
            },
            "of": {
              "channel": {
                "not_in": [
                  "incoming",
                  "system"
                ]
              }
            },
            "by": "count",
            "window": {
              "days": 90
            },
            "op": ">=",
            "value": 0.5
          },
          {
            "id": "branch_count",
            "description": "branch transactions",
            "metric": "count",
            "filter": {
              "channel": "branch"
            },
            "window": {
              "days": 90
            },
            "op": ">=",
            "value": 3
          }
        ]
      },
      "reason": "{branch_share} of self-service transactions in the last 90 days were in a branch, {branch_count} branch transactions"
    },
    {
      "id": "cash-depositor",
      "name": "Regular cash depositor",
      "group": "channels",
      "description": "Deposits cash in most months.",
      "fields": [
        "transactions.category",
        "transactions.direction",
        "transactions.posted_date"
      ],
      "rule": {
        "all": [
          {
            "id": "deposit_months",
            "description": "months with a cash deposit",
            "metric": "months_where",
            "filter": {
              "direction": "credit",
              "category": "cash_deposit"
            },
            "window": {
              "months": 6
            },
            "monthly": {
              "measure": "count",
              "op": ">=",
              "value": 1
            },
            "op": ">=",
            "value": 4
          }
        ]
      },
      "reason": "cash deposited in {deposit_months} of last 6 months"
    },
    {
      "id": "saver",
      "name": "Saver",
      "group": "saving",
      "description": "Regularly moves money to savings, or keeps a good part of what comes in.",
      "fields": [
        "transactions.amount",
        "transactions.category",
        "transactions.currency",
        "transactions.direction",
        "transactions.posted_date"
      ],
      "rule": {
        "any": [
          {
            "id": "transfer_months",
            "description": "months with a transfer to savings",
            "metric": "months_where",
            "filter": {
              "direction": "debit",
              "category": "savings_transfer"
            },
            "window": {
              "months": 6
            },
            "monthly": {
              "measure": "count",
              "op": ">=",
              "value": 1
            },
            "op": ">=",
            "value": 5
          },
          {
            "id": "surplus_months",
            "description": "months where at least 20% of money in was kept (interest not counted)",
            "metric": "months_where",
            "filter": {
              "category": {
                "not_in": [
                  "interest"
                ]
              }
            },
            "window": {
              "months": 12
            },
            "monthly": {
              "measure": "net_flow_ratio",
              "op": ">=",
              "value": 0.2
            },
            "op": ">=",
            "value": 9
          }
        ]
      },
      "reason": "moved money to savings in {transfer_months} of last 6 months; kept 20% or more of money in during {surplus_months} of last 12 months"
    },
    {
      "id": "investor",
      "name": "Investor",
      "group": "saving",
      "description": "Buys investments.",
      "fields": [
        "transactions.category",
        "transactions.direction",
        "transactions.posted_date"
      ],
      "rule": {
        "all": [
          {
            "id": "invest_count",
            "description": "investment purchases",
            "metric": "count",
            "filter": {
              "direction": "debit",
              "category": "investment"
            },
            "window": {
              "days": 180
            },
            "op": ">=",
            "value": 2
          }
        ]
      },
      "reason": "{invest_count} investment purchases in the last 180 days"
    },
    {
      "id": "spending-exceeds-inflow",
      "name": "Spending exceeds money in",
      "group": "saving",
      "description": "Spent clearly more than came in during most recent months.",
      "fields": [
        "transactions.amount",
        "transactions.currency",
        "transactions.direction",
        "transactions.posted_date"
      ],
      "rule": {
        "all": [
          {
            "id": "deficit_months",
            "description": "months where money out exceeded money in by 100 or more (base currency)",
            "metric": "months_where",
            "filter": {},
            "window": {
              "months": 6
            },
            "monthly": {
              "measure": "net_flow",
              "op": "<=",
              "value": -100
            },
            "op": ">=",
            "value": 4
          }
        ]
      },
      "reason": "spent more than came in during {deficit_months} of last 6 months"
    },
    {
      "id": "frequent-traveller",
      "name": "Frequent traveller",
      "group": "travel",
      "description": "Uses a card or ATM abroad in several different months.",
      "fields": [
        "customers.home_country",
        "transactions.channel",
        "transactions.posted_date",
        "transactions.txn_country"
      ],
      "rule": {
        "all": [
          {
            "id": "abroad_months",
            "description": "months with card or ATM use abroad",
            "metric": "months_where",
            "filter": {
              "channel": [
                "card_pos",
                "atm"
              ],
              "is_foreign_country": true
            },
            "window": {
              "months": 12
            },
            "monthly": {
              "measure": "count",
              "op": ">=",
              "value": 1
            },
            "op": ">=",
            "value": 3
          },
          {
            "id": "countries",
            "description": "different countries with card or ATM use",
            "metric": "distinct",
            "field": "txn_country",
            "filter": {
              "channel": [
                "card_pos",
                "atm"
              ],
              "is_foreign_country": true
            },
            "window": {
              "months": 12
            },
            "op": ">=",
            "value": 2
          }
        ]
      },
      "reason": "card or ATM used abroad in {abroad_months} of last 12 months, in {countries} countries"
    },
    {
      "id": "new-customer",
      "name": "New customer",
      "group": "engagement",
      "description": "Opened their account recently.",
      "fields": [
        "customers.account_open_date"
      ],
      "rule": {
        "all": [
          {
            "id": "tenure",
            "description": "days since the account was opened",
            "metric": "tenure_days",
            "op": "<=",
            "value": 90
          }
        ]
      },
      "reason": "account opened {tenure} ago"
    },
    {
      "id": "established-customer",
      "name": "Established customer",
      "group": "engagement",
      "description": "Has banked here for years and is active nearly every month.",
      "fields": [
        "customers.account_open_date",
        "transactions.channel",
        "transactions.posted_date"
      ],
      "rule": {
        "all": [
          {
            "id": "tenure",
            "description": "days since the account was opened",
            "metric": "tenure_days",
            "op": ">=",
            "value": 1095
          },
          {
            "id": "active_months",
            "description": "months with self-service activity",
            "metric": "months_where",
            "filter": {
              "channel": {
                "not_in": [
                  "incoming",
                  "system"
                ]
              }
            },
            "window": {
              "months": 12
            },
            "monthly": {
              "measure": "count",
              "op": ">=",
              "value": 1
            },
            "op": ">=",
            "value": 10
          }
        ]
      },
      "reason": "account open {tenure}, active in {active_months} of last 12 months"
    },
    {
      "id": "going-dormant",
      "name": "Going dormant",
      "group": "engagement",
      "description": "Self-service activity has dropped sharply compared with before.",
      "fields": [
        "customers.account_open_date",
        "transactions.channel",
        "transactions.posted_date"
      ],
      "rule": {
        "all": [
          {
            "id": "activity_change",
            "description": "self-service transactions per month, recent against earlier",
            "metric": "ratio",
            "numerator": {
              "metric": "count_per_month",
              "filter": {
                "channel": {
                  "not_in": [
                    "incoming",
                    "system"
                  ]
                }
              },
              "window": {
                "days": 90
              }
            },
            "denominator": {
              "metric": "count_per_month",
              "filter": {
                "channel": {
                  "not_in": [
                    "incoming",
                    "system"
                  ]
                }
              },
              "window": {
                "days": 270,
                "offset_days": 90
              }
            },
            "min_denominator": 2,
            "op": "<=",
            "value": 0.25,
            "format": "percent"
          },
          {
            "id": "not_dormant",
            "description": "Dormant tag applies",
            "metric": "tag",
            "tag": "dormant",
            "op": "==",
            "value": false
          }
        ]
      },
      "reason": "self-service activity fell to {activity_change} of its earlier level: on average {activity_change.numerator} a month in the last 90 days against {activity_change.denominator} a month in the 270 days before"
    },
    {
      "id": "dormant",
      "name": "Dormant",
      "group": "engagement",
      "description": "No self-service activity for six months.",
      "fields": [
        "customers.account_open_date",
        "transactions.channel",
        "transactions.posted_date"
      ],
      "rule": {
        "all": [
          {
            "id": "self_count",
            "description": "self-service transactions",
            "metric": "count",
            "filter": {
              "channel": {
                "not_in": [
                  "incoming",
                  "system"
                ]
              }
            },
            "window": {
              "days": 180
            },
            "op": "==",
            "value": 0
          },
          {
            "id": "tenure",
            "description": "days since the account was opened",
            "metric": "tenure_days",
            "op": ">=",
            "value": 180
          }
        ]
      },
      "reason": "no self-service transactions in the last 180 days; account open {tenure}"
    },
    {
      "id": "re-engaged",
      "name": "Re-engaged",
      "group": "engagement",
      "description": "Became active again after a long quiet period.",
      "fields": [
        "customers.account_open_date",
        "transactions.channel",
        "transactions.posted_date"
      ],
      "rule": {
        "all": [
          {
            "id": "recent_count",
            "description": "self-service transactions",
            "metric": "count",
            "filter": {
              "channel": {
                "not_in": [
                  "incoming",
                  "system"
                ]
              }
            },
            "window": {
              "days": 90
            },
            "op": ">=",
            "value": 6
          },
          {
            "id": "earlier_count",
            "description": "self-service transactions",
            "metric": "count",
            "filter": {
              "channel": {
                "not_in": [
                  "incoming",
                  "system"
                ]
              }
            },
            "window": {
              "days": 180,
              "offset_days": 90
            },
            "op": "<=",
            "value": 1
          },
          {
            "id": "tenure",
            "description": "days since the account was opened",
            "metric": "tenure_days",
            "op": ">=",
            "value": 270
          }
        ]
      },
      "reason": "{recent_count} self-service transactions in the last 90 days after {earlier_count} in the 180 days before"
    }
  ]
}
