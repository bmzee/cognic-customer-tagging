{
  "schema_version": "1",
  "taxonomy_version": "0.1.0",
  "description": "Behaviour-based customer tags for the customer-tagging plugin. Each tag is a declarative rule over transaction behaviour with explicit thresholds and time windows, and a reason shown to the user. Thresholds are illustrative starting points; bank policy sets the final values.",
  "settings": {
    "base_currency": "USD",
    "fx_rates_to_base": {
      "USD": "1",
      "EUR": "1.10",
      "GBP": "1.30",
      "AED": "0.27",
      "CAD": "0.73",
      "JPY": "0.0070"
    },
    "notes": "Fixed illustrative rates for the synthetic data, not market rates. A deployment supplies the bank's own rate table. Amount thresholds are in the base currency."
  },
  "fairness": {
    "excluded_traits": [
      "religion",
      "ethnicity",
      "race",
      "caste",
      "gender",
      "sex",
      "disability",
      "marital status",
      "pregnancy"
    ],
    "age": "Excluded by default. No tag uses age or date of birth. Adding one needs a tag explicitly marked 'bank policy decides' and an engine change; until then the engine refuses age fields.",
    "proxies_avoided": [
      "health and medical spending (a proxy for disability and health)",
      "charity and worship payments (a proxy for religion)",
      "childcare and school fees (a proxy for family and marital status)",
      "pension income (a proxy for age)",
      "customer names (a proxy for gender and ethnicity)"
    ],
    "notes": "The engine enforces these rules in code (engine/policy.py), so editing this file cannot switch them off. Every tag shows its rule and the evidence that produced it; there are no scores."
  },
  "tags": [
    {
      "id": "salary-earner",
      "name": "Salary earner",
      "group": "income",
      "description": "Receives a salary credit every month.",
      "fields": [
        "transactions.amount",
        "transactions.category",
        "transactions.currency",
        "transactions.direction",
        "transactions.posted_date"
      ],
      "rule": {
        "all": [
          {
            "id": "salary_months",
            "description": "months with a salary credit",
            "metric": "months_where",
            "filter": {
              "direction": "credit",
              "category": "salary"
            },
            "window": {
              "months": 6
            },
            "monthly": {
              "measure": "count",
              "op": ">=",
              "value": 1
            },
            "op": ">=",
            "value": 6
          }
        ]
      },
      "facts": [
        {
          "id": "salary_avg",
          "description": "average salary credited per month",
          "metric": "sum_per_month",
          "filter": {
            "direction": "credit",
            "category": "salary"
          },
          "window": {
            "months": 6
          }
        }
      ],
      "reason": "salary credited monthly, {salary_months} of last 6 months, about {salary_avg} a month"
    },
    {
      "id": "irregular-income",
      "name": "Irregular income",
      "group": "income",
      "description": "Earns income in most months, but the amount swings a lot from month to month and there is no steady salary.",
      "fields": [
        "customers.account_open_date",
        "transactions.amount",
        "transactions.category",
        "transactions.currency",
        "transactions.direction",
        "transactions.posted_date"
      ],
      "rule": {
        "all": [
          {
            "id": "income_months",
            "description": "months with earned income (salary or business income)",
            "metric": "months_where",
            "filter": {
              "direction": "credit",
              "category": [
                "salary",
                "business_income"
              ]
            },
            "window": {
              "months": 12
            },
            "monthly": {
              "measure": "count",
              "op": ">=",
              "value": 1
            },
            "op": ">=",
            "value": 6
          },
          {
            "id": "uneven_months",
            "description": "months where earned income was more than 40% above or below its usual (median) month",
            "metric": "months_where",
            "filter": {
              "direction": "credit",
              "category": [
                "salary",
                "business_income"
              ]
            },
            "window": {
              "months": 12
            },
            "monthly": {
              "measure": "deviation_from_median",
              "op": ">",
              "value": 0.4
            },
            "op": ">=",
            "value": 5
          },
          {
            "id": "no_salary",
            "description": "Salary earner tag applies",
            "metric": "tag",
            "tag": "salary-earner",
            "op": "==",
            "value": false
          },
          {
            "id": "tenure",
            "description": "days since the account was opened",
            "metric": "tenure_days",
            "op": ">=",
            "value": 365
          }
        ]
      },
      "reason": "earned income arrived in {income_months} of last 12 months and was more than 40% above or below its usual month in {uneven_months} of last 12 months; no steady salary"
    },
    {
      "id": "multi-source-income",
      "name": "Several income sources",
      "group": "income",
      "description": "Received earned income from several different payers recently.",
      "fields": [
        "transactions.amount",
        "transactions.category",
        "transactions.counterparty",
        "transactions.currency",
        "transactions.direction",
        "transactions.posted_date"
      ],
      "rule": {
        "all": [
          {
            "id": "payers",
            "description": "different payers of earned income",
            "metric": "distinct",
            "field": "counterparty",
            "filter": {
              "direction": "credit",
              "category": [
                "salary",
                "business_income"
              ]
            },
            "window": {
              "days": 90
            },
            "op": ">=",
            "value": 3
          }
        ]
      },
      "facts": [
        {
          "id": "earned_90",
          "description": "earned income received",
          "metric": "sum",
          "filter": {
            "direction": "credit",
            "category": [
              "salary",
              "business_income"
            ]
          },
          "window": {
            "days": 90
          }
        }
      ],
      "reason": "earned income from {payers} different payers in the last 90 days, {earned_90} in total"
    },
    {
      "id": "business-income",
