          },
          "window": {
            "months": 6
          }
        }
      ],
      "reason": "money received from abroad in {remit_months} of last 6 months, {remit_total} in total"
    },
    {
      "id": "rising-income",
      "name": "Rising income",
      "group": "income",
      "description": "Average monthly earned income in the last 3 months is clearly above the 6 months before.",
      "fields": [
        "transactions.amount",
        "transactions.category",
        "transactions.currency",
        "transactions.direction",
        "transactions.posted_date"
      ],
      "rule": {
        "all": [
          {
            "id": "income_change",
            "description": "average monthly earned income, recent against earlier",
            "metric": "ratio",
            "numerator": {
              "metric": "sum_per_month",
              "filter": {
                "direction": "credit",
                "category": [
                  "salary",
                  "business_income"
                ]
              },
              "window": {
                "months": 3
              }
            },
            "denominator": {
              "metric": "sum_per_month",
              "filter": {
                "direction": "credit",
                "category": [
                  "salary",
                  "business_income"
                ]
              },
              "window": {
                "months": 6,
                "offset_months": 3
              }
            },
            "min_denominator": 300,
            "op": ">=",
            "value": 1.25,
            "format": "percent"
          },
          {
            "id": "recent_months",
            "description": "months with earned income",
            "metric": "months_where",
            "filter": {
              "direction": "credit",
              "category": [
                "salary",
                "business_income"
              ]
            },
            "window": {
              "months": 3
            },
            "monthly": {
              "measure": "count",
              "op": ">=",
              "value": 1
            },
            "op": ">=",
            "value": 3
          }
        ]
      },
      "reason": "average monthly earned income rose to {income_change} of its earlier level: {income_change.numerator} a month in the last 3 months against {income_change.denominator} in the 6 months before"
    },
    {
      "id": "falling-income",
      "name": "Falling income",
      "group": "income",
      "description": "Average monthly earned income in the last 3 months is well below the 6 months before.",
      "fields": [
        "transactions.amount",
        "transactions.category",
        "transactions.currency",
        "transactions.direction",
        "transactions.posted_date"
      ],
      "rule": {
        "all": [
          {
            "id": "income_change",
            "description": "average monthly earned income, recent against earlier",
            "metric": "ratio",
            "numerator": {
              "metric": "sum_per_month",
              "filter": {
                "direction": "credit",
                "category": [
                  "salary",
                  "business_income"
                ]
              },
              "window": {
                "months": 3
              }
            },
